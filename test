<div id="screen-lexicon" class="screen">
  <div class="topbar">
    <button class="topbar-back" onclick="goHome()"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Accueil</button>
